{
  "info": {
    "name": "Grupo Cordillera — API REST EP3",
    "description": "Colección completa de endpoints. Base URL vía API Gateway (puerto 80). Ejecutar primero Auth/Login y guardar el token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway", "value": "http://localhost:80",  "type": "string" },
    { "key": "token",   "value": "pegar-token-aqui",     "type": "string" }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "url":    "{{gateway}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body":   { "mode": "raw", "raw": "{\"username\":\"admin\",\"password\":\"admin123\"}" }
          },
          "response": [
            {
              "name": "200 OK — Token generado",
              "status": "OK",
              "code": 200,
              "body": "{\"token\":\"uuid-generado\",\"username\":\"admin\",\"timestamp\":\"2026-06-28T12:00:00\"}"
            }
          ]
        },
        {
          "name": "Login Usuario",
          "request": {
            "method": "POST",
            "url":    "{{gateway}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body":   { "mode": "raw", "raw": "{\"username\":\"usuario\",\"password\":\"user123\"}" }
          }
        },
        {
          "name": "Validar Token",
          "request": {
            "method": "POST",
            "url":    "{{gateway}}/auth/validate",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          },
          "response": [
            {
              "name": "200 OK — Token válido",
              "status": "OK",
              "code": 200,
              "body": "{\"valid\":true}"
            },
            {
              "name": "401 — Token inválido",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\"error\":\"Token inválido o expirado\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "2. BFF — Dashboard y datos agregados",
      "item": [
        {
          "name": "Dashboard completo",
          "request": {
            "method": "GET",
            "url":    "{{gateway}}/api/proxy/dashboard",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"ventas\":[],\"indicadores\":{\"itemsInventario\":112,\"totalHorasTrabajadas\":740},\"reportes\":{\"totalEventos\":14,\"totalMonto\":5697044},\"timestamp\":\"2026-06-28T12:00:00\"}"
            }
          ]
        },
        {
          "name": "Indicadores (ORQ-IND)",
          "request": {
            "method": "GET",
            "url":    "{{gateway}}/api/proxy/indicadores",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Reportes (ORQ-REP)",
          "request": {
            "method": "GET",
            "url":    "{{gateway}}/api/proxy/reportes",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "3. BFF — Datos crudos",
      "item": [
        {
          "name": "Ventas (POS + Online)",
          "request": {
            "method": "GET",
            "url":    "{{gateway}}/api/proxy/ventas",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "[{\"transactionId\":\"TRX-POS-0001-1234\",\"canal\":\"Tienda Física\",\"sucursal\":\"Las Condes\",\"montoTotal\":29990,\"fecha\":\"2026-06-28\"}]"
            }
          ]
        },
        {
          "name": "Inventario (MS3)",
          "request": {
            "method": "GET",
            "url":    "{{gateway}}/api/proxy/datos/inventario",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Empleados (MS4)",
          "request": {
            "method": "GET",
            "url":    "{{gateway}}/api/proxy/datos/empleados",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Eventos Financieros (MS5)",
          "request": {
            "method": "GET",
            "url":    "{{gateway}}/api/proxy/datos/eventos",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
